# Server
NODE_ENV=development
PORT=3001

# MongoDB — local Docker (run `docker compose up -d` from repo root):
MONGODB_URI=mongodb://localhost:27017/opensora
# MongoDB Atlas (production):
# MONGODB_URI=mongodb+srv://app-prod:<password>@opensoraxyz-prod.XXXXX.mongodb.net/opensoraxyz?retryWrites=true&w=majority
# See apps/api/.env.production.example for the full production template.

# JWT (required — must be at least 32 chars)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# Cloudflare R2 (optional — if not set, video URLs from fal.ai are stored directly)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=opensora-videos
R2_PUBLIC_DOMAIN=

# AI Video Generation (optional — if not set, mock mode is used)
FAL_KEY=
REPLICATE_API_TOKEN=

# CORS (default: allow all)
CORS_ORIGIN=*

# Credits
FREE_CREDITS_ON_SIGNUP=10
CREDITS_PER_GENERATION=1
